penguins %>%
drop_na() %>%
ggplot(aes(x = body_mass_g,
fill = sex)) +
geom-density(alpha = 0.5)
#T test
penguins %>%
drop_na() %>%
ggplot(aes(x = body_mass_g,
fill = sex)) +
geom_density(alpha = 0.5)
t.test(body_mss_g, sex)
penguins %>%
t.test(body_mss_g, sex)
t.test(body_mss_g ~ sex, data = penguins)
