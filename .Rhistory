peng %>%
mutate(Gentoo = case_when(species == 'Gentoo' ~ TRUE, TRUE ~ FALSE)) %>% View()
peng %>%
mutate(Gentoo = case_when(species == 'Gentoo' ~ TRUE, TRUE ~ FALSE)) %>%
View()
#Logistic regression models, outcome is true or false and not continous
peng = penguins
peng %>%
mutate(Gentoo = case_when(species == 'Gentoo' ~ TRUE, TRUE ~ FALSE))
View(peng)
peng %>%
mutate(Gentoo = case_when(species == 'Gentoo' ~ TRUE, TRUE ~ FALSE)) %>%
View()
mod_log = glm(data = peng2,
formula = Gentoo ~ bill_length_mm + bill_depth_mm + flipper_length_mm + body_mass_g)
#Logistic regression models, outcome is true or false and not continous
peng = penguins
peng2 = peng %>%
mutate(Gentoo = case_when(species == 'Gentoo' ~ TRUE, TRUE ~ FALSE))
mod_log = glm(data = peng2,
formula = Gentoo ~ bill_length_mm + bill_depth_mm + flipper_length_mm + body_mass_g)
summary(mod_log)
mod_log = glm(data = peng2,
formula = Gentoo ~ bill_length_mm + bill_depth_mm + flipper_length_mm + body_mass_g,
family = 'binomial')
peng2$pred = predict(mod_log, peng2, type = 'response')
View(peng2)
mod_log = glm(data = peng2,
formula = Gentoo ~ bill_length_mm + bill_depth_mm + flipper_length_mm + body_mass_g,
family = 'binomial')
View(peng2)
View(peng2)
#validating a model
peng3 = peng2 %>%
mutate(Outcome = case_when(pred2 > 0.75 ~ 'Gentoo',
pred2 < 0.25 ~ 'Not Gentoo',
TRUE ~ 'IDK'))
#validating a model
peng3 = peng2 %>%
mutate(Outcome = case_when(pred > 0.75 ~ 'Gentoo',
pred < 0.25 ~ 'Not Gentoo',
TRUE ~ 'IDK'))
View(peng3)
pluck('Outcome') %>%
sum()
